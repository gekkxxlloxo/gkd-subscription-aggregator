// 常驻自定义规则 - 由 AI 根据用户提供的 GKD 快照编写
// 每次 GitHub Actions 同步时会被并入 merged.json5，不会被上游源覆盖
// 规则组 key 使用 9000 以上，避免与上游规则组的 key 冲突
// 新增规则请按快照的真实节点属性编写（text / desc / clickable / 层级）
{
  apps: [
    {
      id: 'com.kugou.android',
      name: '酷狗音乐',
      groups: [
        {
          key: 9001,
          name: '开屏广告-跳过按钮(快照定制)',
          activityIds: ['com.kugou.android.app.MediaActivity'],
          rules: [
            {
              // 广点通开屏 UniSplashCard 内，点"跳过"文字的可点击父容器
              // 快照验证: 节点16 text=跳过 clickable=false, 父节点15 clickable=true
              matches: '[desc="UniSplashCard"] @ViewGroup[clickable=true] > [text="跳过"]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 9002,
          name: '信息流广告-关闭按钮(快照定制)',
          activityIds: ['com.kugou.android.app.MediaActivity'],
          rules: [
            {
              // 首页信息流广告卡片右上角的 X：desc="关闭" 且 clickable=true 的 ImageView
              // 快照验证(2026-11-20): 节点261 desc=关闭 clickable=true, bounds 1260,2227-1440,2407
              // 全树 desc=关闭 且 clickable=true 仅此一个；desc=关闭侧边栏 是不同值不会误匹配
              matches: '[desc="关闭"][clickable=true]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 9005,
          name: '签到弹窗-立即签到(快照定制)',
          activityIds: ['com.kugou.android.app.MediaActivity'],
          rules: [
            {
              // 豪华VIP签到奖励弹窗里的"立即签到"粉红大按钮
              // 该弹窗为 Flutter 渲染，无 text/desc 锚点，只能用结构+尺寸定位
              // 快照验证(2026-11-21): 节点47 ViewGroup[childCount=7] 是签到天数行(7个奖励格)
              // 它的下一个兄弟节点103 ViewGroup[clickable=true] 即"立即签到"(1200x160)，全树唯一
              // 注意 108 是下方"点击广告签到"按钮，尺寸相同，靠 childCount=7 的前缀排除
              matches: 'ViewGroup[childCount=7] + ViewGroup[clickable=true]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 9006,
          name: '签到成功弹窗-关闭X(快照定制)',
          activityIds: ['com.kugou.android.app.MediaActivity'],
          rules: [
            {
              // 金币中心"签到成功"弹窗右上角的 X
              // 同为 Flutter 渲染无文字锚点，尺寸定位: 节点414 clickable=true 70x70
              // 快照验证(2026-11-21): 全树 clickable 且 70x70 仅此一个，唯一命中
              matches: 'ViewGroup[clickable=true][width>50][width<90][height>50][height<90]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
    {
      id: 'app.morphe.android.youtube',
      name: 'YouTube Morphe',
      groups: [
        {
          key: 9003,
          name: '跳过开头-赞助片段(快照定制)',
          activityIds: ['com.google.android.apps.youtube.app.watchwhile.MainActivity'],
          rules: [
            {
              // 按钮文字 "跳过开头" 的节点 clickable=false，真正可点的是外层 FrameLayout
              // 快照验证(2026-11-21): 节点49 text=跳过开头 clickable=false
              // 父节点47 desc=跳过 clickable=true, bounds 1020,594-1440,786（全树唯一）
              matches: '[desc="跳过"][clickable=true]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
    {
      id: 'com.alibaba.android.rimet',
      name: '钉钉',
      groups: [
        {
          key: 9004,
          name: '首页横幅广告-关闭按钮(快照定制)',
          activityIds: ['com.alibaba.android.rimet.biz.LaunchHomeActivity'],
          rules: [
            {
              // 首页消息列表顶部横幅广告右上角的 X
              // 快照验证(2026-11-21): 红圈中心(1292,683)
              // 节点63 icft_close text=\ue9fe clickable=false (字体图标，点不到)
              // 父节点62 layout_close FrameLayout clickable=true
              // bounds 1272,624-1352,704（全树 vid=layout_close 唯一）
              matches: '[vid="layout_close"][clickable=true]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
    {
      id: 'com.hzpd.jwztc',
      name: '警察叔叔',
      groups: [
        {
          key: 9007,
          name: '温馨提醒弹窗-关闭X(快照定制)',
          activityIds: ['com.alibaba.gov.android.skeleton.entry.activity.MainTabActivity'],
          rules: [
            {
              // 首页"温馨提醒"公告弹窗下方 banner 的 X（白色圆圈的关闭按钮）
              // 快照验证(2026-11-21): 节点385 ImageView vid=iv_close clickable=true
              // bounds 573,2477-866,2770（全树 vid=iv_close 唯一）
              matches: '[vid="iv_close"][clickable=true]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
    {
      id: 'com.tencent.mm',
      name: '微信',
      groups: [
        {
          key: 9008,
          name: '小程序促销弹窗-关闭X-FamilyMart(快照定制)',
          activityIds: ['.plugin.appbrand.ui.AppBrandUI'],
          rules: [
            {
              // 微信小程序(全家 FamilyMart)商品促销弹窗底部的白色圆圈 X
              // H5 广告: X 是 WebView 内 android.widget.Image，clickable=false
              // 快照验证(2026-11-21): 节点138 Image box=672,2308-768,2408 (96x100)
              // 同名同尺寸另有顶部横幅图标54，用父容器 childCount=2 排除；全树唯一命中
              matches: 'View[childCount=2] > Image[width>85][width<105][height>90][height<110]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 9009,
          name: '小程序促销弹窗-关闭X-银泰(快照定制)',
          activityIds: ['.plugin.appbrand.ui.AppBrandUI'],
          rules: [
            {
              // 微信小程序(临平银泰)关东煮代金券促销弹窗底部的白色圆圈 X
              // H5 广告: X 是 WebView 内 android.widget.TextView text=私用区\ue75c，clickable=false
              // 快照验证(2026-11-21): 节点44 box=680,2320-760,2400 (80x80)
              // text=私用区字符全树唯一；尺寸 80x80 的 TextView 也唯一
              matches: 'TextView[text="\ue75c"]',
              action: 'clickCenter',
            },
          ],
        },
        {
          key: 9010,
          name: '小程序顶部横幅广告-关闭X(快照定制)',
          activityIds: ['.plugin.appbrand.ui.AppBrandUI'],
          rules: [
            {
              // 微信小游戏页面顶部"钻会员专享优惠"横幅右侧的白色圆圈 X
              // H5 广告: X 是 WebView 内 android.widget.ImageView，clickable=false
              // 快照验证(2026-11-21): 节点73 box=1104,554-1232,682 (128x128)
              // 用 ImageView 精确标签 + 尺寸定位：全树 ImageView 中该尺寸唯一
              // 注意用 ImageView 而非 Image，后者会匹配到底部4个124x120导航图标
              matches: 'ImageView[width>115][width<140][height>115][height<140]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
  ],
  globalGroups: [],
}
